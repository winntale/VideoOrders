@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var login = isAuthenticated ? User.Identity?.Name : null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Video Orders")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="navbar">
    <div class="navbar-inner">
        <a class="brand" asp-controller="Home" asp-action="Index">Video Orders</a>
        @if (isAuthenticated)
        {
            <nav class="nav">
                <a asp-controller="Orders" asp-action="New">Новый заказ</a>
                <a asp-controller="Orders" asp-action="Index">Мои заказы</a>
                <a asp-controller="Notifications" asp-action="Index">
                    Уведомления <span id="notif-badge" class="notif-badge" hidden>0</span>
                </a>
            </nav>
            <form method="post" asp-controller="Account" asp-action="Logout" class="logout-form">
                <span class="user-id">@login</span>
                <button type="submit">Выход</button>
            </form>
        }
    </div>
</header>
<main class="container">
    @RenderBody()
</main>
<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>
@if (isAuthenticated)
{
    <script src="~/js/notifications-poller.js" asp-append-version="true"></script>
}
@RenderSection("Scripts", required: false)
</body>
</html>
