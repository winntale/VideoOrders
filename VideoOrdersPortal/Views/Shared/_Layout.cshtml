@{
    var userId = User.Identity?.IsAuthenticated == true
        ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        : null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Video Orders")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="navbar">
    <div class="navbar-inner">
        <a class="brand" asp-controller="Home" asp-action="Index">Video Orders</a>
        @if (userId != null)
        {
            <nav class="nav">
                <a asp-controller="Orders" asp-action="New">Новый заказ</a>
                <a asp-controller="Orders" asp-action="Index">Мои заказы</a>
            </nav>
            <form method="post" asp-controller="Account" asp-action="Logout" class="logout-form">
                <span class="user-id" title="@userId">@userId</span>
                <button type="submit">Выход</button>
            </form>
        }
    </div>
</header>
<main class="container">
    @RenderBody()
</main>
@RenderSection("Scripts", required: false)
</body>
</html>
