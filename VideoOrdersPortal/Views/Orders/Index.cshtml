@{
    ViewData["Title"] = "Мои заказы";
}
<section>
    <div class="page-header">
        <h1>Мои заказы</h1>
        <a class="primary" asp-controller="Orders" asp-action="New">+ Новый заказ</a>
    </div>

    <table class="orders-table">
        <thead>
        <tr>
            <th>Камера</th>
            <th>Интервал</th>
            <th>Статус</th>
            <th>Размер</th>
            <th>Действия</th>
        </tr>
        </thead>
        <tbody id="orders-body">
        <tr><td colspan="5" class="muted">Загрузка…</td></tr>
        </tbody>
    </table>

    <dialog id="player-dialog">
        <video id="player" controls preload="metadata" style="width:100%;max-height:70vh"></video>
        <form method="dialog"><button>Закрыть</button></form>
    </dialog>
</section>
@section Scripts {
    <script src="~/js/orders-index.js" asp-append-version="true"></script>
}
