# Универсальный многоэтапный Dockerfile для .NET сервисов VideoOrders.
# Аргументы:
#   PROJECT_PATH  — путь к директории с csproj (например, UserService/Gateway)
#   PROJECT_NAME  — имя csproj без расширения (например, Gateway или VideoOrdersPortal)

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG PROJECT_PATH
ARG PROJECT_NAME=Gateway
WORKDIR /src

COPY . .

RUN dotnet restore "${PROJECT_PATH}/${PROJECT_NAME}.csproj"
RUN dotnet publish "${PROJECT_PATH}/${PROJECT_NAME}.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ARG PROJECT_NAME=Gateway
WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Development
ENV ENTRY_DLL=${PROJECT_NAME}.dll

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "exec dotnet ${ENTRY_DLL}"]
